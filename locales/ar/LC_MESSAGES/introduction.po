#~ " Developed country Parties may wish "
#~ "to submit information on these "
#~ "indicators on a voluntary basis for "
#~ "the purpose of reporting on progress "
#~ "towards the SDGs."
#~ msgstr ""

#~ msgid ""
#~ "Analytical, synthesis and visualization "
