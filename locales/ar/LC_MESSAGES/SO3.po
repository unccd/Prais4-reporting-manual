#: ../../SO3.md:360
msgid "Total population exposed to drought in 2020–2023"
msgstr "إجمالي السكان المعرضين للجفاف في الفترة 2020–2023"

# Requires manual validation; translated with DeepL
#: ../../SO3.md:362
msgid ""
"These maps show the highest drought intensity class a population was exposed"
