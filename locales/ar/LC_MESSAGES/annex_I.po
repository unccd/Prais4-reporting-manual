#~ msgid "Accept the default Creative Commons (CC) licence."
#~ msgstr "قبول رخصة المشاع الإبداعي الافتراضي."

#~ msgid ""
#~ "Choose an alternative CC licence which applies additional restrictions on "
#~ "the use of the data, or use an existing licence of your own."
#~ msgstr ""
#~ "يُرجى اختيار رخصة مشاع إبداعي بديلة تُطبِق قيوداً إضافية على استخدام "
