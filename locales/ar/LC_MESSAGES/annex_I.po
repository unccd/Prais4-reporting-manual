#~ msgid "NonCommercial — You may not use the material for commercial purposes."
#~ msgstr "غير تجاري - لا يجوز لكم استخدام المواد للأغراض التجارية."

#~ msgid ""
#~ "To find out more about this licence (translated into all United Nations "
#~ "languages), please visit this "
